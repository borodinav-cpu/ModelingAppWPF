<Window x:Class="ModelingAppWPF.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор цвета"
        Width="320" Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#252525">

    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#3B82F6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview -->
        <Border Grid.Row="0" x:Name="PreviewBorder" 
                Background="#3B82F6" CornerRadius="6"
                BorderBrush="#444" BorderThickness="1"/>

        <!-- Sliders -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">

            <!-- R -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="R" Foreground="#E07070" FontWeight="Bold"/>
                <Slider Grid.Column="1" x:Name="SliderR" Minimum="0" Maximum="255" Value="59"
                        ValueChanged="Slider_Changed" VerticalAlignment="Center" Margin="8,0"/>
                <TextBox Grid.Column="2" x:Name="BoxR" Text="59" TextChanged="Box_Changed"/>
            </Grid>

            <!-- G -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="G" Foreground="#70C070" FontWeight="Bold"/>
                <Slider Grid.Column="1" x:Name="SliderG" Minimum="0" Maximum="255" Value="130"
                        ValueChanged="Slider_Changed" VerticalAlignment="Center" Margin="8,0"/>
                <TextBox Grid.Column="2" x:Name="BoxG" Text="130" TextChanged="Box_Changed"/>
            </Grid>

            <!-- B -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="B" Foreground="#7090E0" FontWeight="Bold"/>
                <Slider Grid.Column="1" x:Name="SliderB" Minimum="0" Maximum="255" Value="246"
                        ValueChanged="Slider_Changed" VerticalAlignment="Center" Margin="8,0"/>
                <TextBox Grid.Column="2" x:Name="BoxB" Text="246" TextChanged="Box_Changed"/>
            </Grid>

            <!-- HEX -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Foreground="#888"/>
                <TextBox Grid.Column="1" x:Name="BoxHex" Text="3B82F6" Margin="8,0"
                         FontFamily="Consolas" Width="Auto"
                         TextChanged="HexBox_Changed"/>
            </Grid>

            <!-- Preset swatches -->
            <TextBlock Text="Быстрые цвета" Foreground="#666" FontSize="10"
                       Margin="0,16,0,6"/>
            <WrapPanel x:Name="Swatches">
               
            </WrapPanel>
        </StackPanel>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Cancel_Click">Отмена</Button>
            <Button Style="{StaticResource Btn}" Background="#1D4ED8" BorderBrush="#2563EB"
                    Foreground="White" Click="OK_Click">OK</Button>
        </StackPanel>
    </Grid>
</Window>
