<Window x:Class="ModelingAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="ModelingApp - Basic" 
        Height="700" Width="1200"
        Background="#2B2B2B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="#3C3F41" Padding="10,5">
            <StackPanel Orientation="Horizontal">


                
                <GroupBox Header="Примитивы" Foreground="White" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="AddPrimitive_Click" 
                Padding="15,5" 
                Margin="2"
                Background="#3B82F6" 
                Foreground="White"
                BorderThickness="0" 
                Cursor="Hand"
                Width="120">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕ " FontSize="14"/>
                                <TextBlock Text="Примитив"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </GroupBox>


                <GroupBox Header="Файлы" Foreground="White" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="ImportModel_Click" 
                                Padding="10,5" Margin="2"
                                Background="#4B5052" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" Margin="0,0,5,0"/>
                                <TextBlock Text="Импорт"/>
                            </StackPanel>
                        </Button>

                        <!--<Button Click="ExportModel_Click" 
                                Padding="10,5" Margin="2"
                                Background="#4B5052" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" Margin="0,0,5,0"/>
                                <TextBlock Text="Экспорт"/>
                            </StackPanel>
                        </Button>-->
                    </StackPanel>
                </GroupBox>

                
                <GroupBox Header="Трансформация" Foreground="White" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="RotateX_Click" 
                                Padding="10,5" Margin="2"
                                Background="#4B5052" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="↻ X"/>
                        </Button>

                        <Button Click="RotateY_Click" 
                                Padding="10,5" Margin="2"
                                Background="#4B5052" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="↻ Y"/>
                        </Button>
                        <Button Click="RotateZ_Click" 
                                Padding="10,5" Margin="2"
                                 Background="#4B5052" Foreground="White"
                                 BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="↻ Z"/>
                        </Button>

                        <Button Click="ScaleUp_Click" 
                                Padding="10,5" Margin="2"
                                Background="#4B5052" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="⬆ Размер"/>
                        </Button>

                        <Button Click="ScaleDown_Click" 
                                Padding="10,5" Margin="2"
                                Background="#4B5052" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="⬇ Размер"/>
                        </Button>
                    </StackPanel>
                </GroupBox>

               
                <GroupBox Header="Сцена" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="ClearScene_Click" 
                                Padding="10,5" Margin="2"
                                Background="#E74C3C" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="🗑️ Очистить"/>
                        </Button>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Border>

       
        <Grid Grid.Row="1" Margin="10">
            <hx:HelixViewport3D Name="view3D" 
                                Background="#1E1E1E"
                                ZoomExtentsWhenLoaded="True"
                                ShowFrameRate="True"
                                ShowTriangleCountInfo="True"
                                ShowViewCube="True"
                                ShowCoordinateSystem="True"
                                RotateAroundMouseDownPoint="True"
                                ZoomAroundMouseDownPoint="True">

               
                <hx:DefaultLights/>

               
                

                <hx:GridLinesVisual3D Width="400" Length="400" 
                                       MinorDistance="10" MajorDistance="50" 
                                       Thickness="0.5"
                                       Fill="#555555"/>

            </hx:HelixViewport3D>
        </Grid>
    </Grid>
</Window>