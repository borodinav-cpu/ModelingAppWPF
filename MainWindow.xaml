<Window x:Class="ModelingAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:ModelingAppWPF"
        Title="ModelingApp" 
        Height="780" Width="1400"
        MinHeight="600" MinWidth="1000"
        Background="#1A1A1A">

    <Window.Resources>
        <!-- ======= COLORS ======= -->
        <SolidColorBrush x:Key="BgPrimary"    Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BgSecondary"  Color="#252525"/>
        <SolidColorBrush x:Key="BgTertiary"   Color="#2B2B2B"/>
        <SolidColorBrush x:Key="BgHover"      Color="#313131"/>
        <SolidColorBrush x:Key="BgActive"     Color="#1E3A5F"/>
        <SolidColorBrush x:Key="Accent"       Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover"  Color="#2563EB"/>
        <SolidColorBrush x:Key="Border"       Color="#111111"/>
        <SolidColorBrush x:Key="BorderMid"    Color="#3A3A3A"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#888888"/>
        <SolidColorBrush x:Key="TextDim"      Color="#555555"/>
        <SolidColorBrush x:Key="DangerBg"     Color="#7F1D1D"/>
        <SolidColorBrush x:Key="DangerFg"     Color="#FCA5A5"/>
        <SolidColorBrush x:Key="AxisX"        Color="#E07070"/>
        <SolidColorBrush x:Key="AxisY"        Color="#70C070"/>
        <SolidColorBrush x:Key="AxisZ"        Color="#7090E0"/>

        <!-- ======= MENU ITEM STYLE ======= -->
        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C3C3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======= TOOLBAR BUTTON ======= -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarBtnAccent" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarBtnDanger" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======= TREE ITEM ======= -->
        <Style x:Key="SceneTreeItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Margin="4,1" CornerRadius="4"
                                BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======= SCROLLBAR ======= -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
        </Style>

        <!-- ======= PANEL SECTION HEADER ======= -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- ======= PROPERTY LABEL ======= -->
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="65"/>
        </Style>

        <!-- ======= PROPERTY FIELD ======= -->
        <Style x:Key="PropField" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="#3B82F6"/>
            <Setter Property="SelectionBrush" Value="#3B82F6"/>
        </Style>

        <!-- ======= XYZ MINI FIELD ======= -->
        <Style x:Key="XyzField" TargetType="TextBox" BasedOn="{StaticResource PropField}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- ======= SLIDER ======= -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#3B82F6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>   <!-- Menu bar -->
            <RowDefinition Height="38"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="20"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== MENU BAR ===== -->
        <Border Grid.Row="0" Background="#242424" BorderBrush="#111" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" VerticalAlignment="Center" Margin="4,0">
                <MenuItem Header="Файл" Style="{StaticResource MenuItemStyle}">
                    <MenuItem Header="Новый" Click="MenuNew_Click"/>
                    <MenuItem Header="Открыть..." Click="MenuOpen_Click"/>
                    <Separator/>
                    <MenuItem Header="Сохранить" Click="MenuSave_Click"/>
                    <MenuItem Header="Сохранить как..."/>
                    <Separator/>
                    <MenuItem Header="Импорт модели..." Click="ImportModel_Click"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="MenuExit_Click"/>
                </MenuItem>
                <MenuItem Header="Правка" Style="{StaticResource MenuItemStyle}">
                    <MenuItem Header="Отменить" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="Повторить" InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Выделить всё" InputGestureText="Ctrl+A"/>
                    <MenuItem Header="Удалить" Click="DeleteSelected_Click"/>
                </MenuItem>
                <MenuItem Header="Вид" Style="{StaticResource MenuItemStyle}">
                    <MenuItem Header="Перспектива" Click="MenuPerspective_Click"/>
                    <MenuItem Header="Спереди"/>
                    <MenuItem Header="Сверху"/>
                    <Separator/>
                    <MenuItem Header="Каркасный режим" Click="MenuWireframe_Click"/>
                    <MenuItem Header="Затенённый"/>
                </MenuItem>
                <MenuItem Header="Объект" Style="{StaticResource MenuItemStyle}">
                    <MenuItem Header="Добавить примитив..." Click="AddPrimitive_Click"/>
                    <Separator/>
                    <MenuItem Header="Вращение X..." Click="RotateX_Click"/>
                    <MenuItem Header="Вращение Y..." Click="RotateY_Click"/>
                    <MenuItem Header="Вращение Z..." Click="RotateZ_Click"/>
                </MenuItem>
                <MenuItem Header="Справка" Style="{StaticResource MenuItemStyle}">
                    <MenuItem Header="О программе"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="1" Background="#323232" BorderBrush="#111" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" >

                <!-- File group -->
                <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="MenuNew_Click" ToolTip="Новый проект">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🗋 " FontSize="13"/><TextBlock Text="Новый"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="MenuOpen_Click" ToolTip="Открыть">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📂 " FontSize="13"/><TextBlock Text="Открыть"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="MenuSave_Click" ToolTip="Сохранить">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="💾 " FontSize="13"/><TextBlock Text="Сохранить"/></StackPanel>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#444" Margin="4,4"/>

                <!-- Add / Import -->
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <Button Style="{StaticResource ToolbarBtnAccent}" Margin="0,0,3,0" Click="AddPrimitive_Click" ToolTip="Добавить примитив">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✦ " FontSize="13"/><TextBlock Text="Примитив"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="ImportModel_Click" ToolTip="Импорт модели">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📥 " FontSize="13"/><TextBlock Text="Импорт"/></StackPanel>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#444" Margin="4,4"/>

                <!-- Rotation -->
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <TextBlock Text="Вращение:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="RotateX_Click" ToolTip="Вращение по X">
                        <TextBlock><Run Foreground="#E07070" FontWeight="Bold">X</Run><Run Text="°"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="RotateY_Click" ToolTip="Вращение по Y">
                        <TextBlock><Run Foreground="#70C070" FontWeight="Bold">Y</Run><Run Text="°"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="RotateZ_Click" ToolTip="Вращение по Z">
                        <TextBlock><Run Foreground="#7090E0" FontWeight="Bold">Z</Run><Run Text="°"/></TextBlock>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#444" Margin="4,4"/>

                <!-- Scale -->
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <TextBlock Text="Масштаб:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="ScaleUp_Click" ToolTip="Увеличить">
                        <TextBlock Text="⤢ +"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="ScaleDown_Click" ToolTip="Уменьшить">
                        <TextBlock Text="⤡ −"/>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#444" Margin="4,4"/>

                <!-- View mode -->
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <TextBlock Text="Вид:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnPerspective" Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="MenuPerspective_Click" ToolTip="Перспектива">
                        <TextBlock Text="⬚ Перспектива"/>
                    </Button>
                    <Button x:Name="BtnWireframe" Style="{StaticResource ToolbarBtn}" Margin="0,0,3,0" Click="MenuWireframe_Click" ToolTip="Каркас">
                        <TextBlock Text="◫ Каркас"/>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#444" Margin="4,4"/>

                <!-- Delete -->
                <Button Style="{StaticResource ToolbarBtnDanger}" Margin="4,0,0,0" Click="DeleteSelected_Click" ToolTip="Удалить выбранный объект">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🗑 " FontSize="13"/><TextBlock Text="Удалить"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== MAIN AREA ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="195" MinWidth="140" MaxWidth="320"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="210" MinWidth="160" MaxWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ====== LEFT PANEL: Scene tree ====== -->
            <Border Grid.Column="0" Background="#252525" BorderBrush="#111" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="СЦЕНА" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Tree -->
                    <ListBox x:Name="SceneTreeList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SceneTreeItem}"
                             SelectionChanged="SceneTree_SelectionChanged"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Padding="0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{Binding NameColor}"/>
                                    <Button Grid.Column="2" Content="{Binding EyeIcon}" FontSize="11"
                                            Background="Transparent" BorderThickness="0" Foreground="#888888"
                                            Cursor="Hand" ToolTip="Видимость"
                                            Click="ToggleVisibility_Click" Tag="{Binding}"
                                            Opacity="{Binding EyeOpacity}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add button -->
                    <Border Grid.Row="2" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="8,6">
                        <Button Style="{StaticResource ToolbarBtn}" Click="AddPrimitive_Click">
                            <TextBlock Text="+ Добавить объект" FontSize="11" HorizontalAlignment="Center"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter left -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1A1A1A" Cursor="SizeWE"/>

            <!-- ====== VIEWPORT ====== -->
            <Grid Grid.Column="2" Background="#1A1A1A">
                <hx:HelixViewport3D x:Name="Viewport3D"
                                    Background="#1A1A1A"
                                    ShowCoordinateSystem="False"
                                    ShowFrameRate="False"
                                    ShowCameraInfo="False"
                                    IsInertiaEnabled="True"
                                    ZoomExtentsWhenLoaded="True">
                    <hx:DefaultLights/>
                </hx:HelixViewport3D>

                <!-- Viewport label -->
                <TextBlock x:Name="ViewportLabel" Text="Перспектива | Затенение"
                           Foreground="#555" FontSize="10" Margin="8,6,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Left"
                           IsHitTestVisible="False"/>

                <!-- Viewport overlay buttons -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,8,0" IsHitTestVisible="True">
                    <Button Width="26" Height="26" Margin="0,0,0,3" ToolTip="Приблизить"
                            Style="{StaticResource ToolbarBtn}" FontSize="14">+</Button>
                    <Button Width="26" Height="26" Margin="0,0,0,3" ToolTip="Отдалить"
                            Style="{StaticResource ToolbarBtn}" FontSize="14">−</Button>
                    <Button Width="26" Height="26" Margin="0,0,0,3" ToolTip="Сбросить вид"
                            Style="{StaticResource ToolbarBtn}" Click="ResetCamera_Click" FontSize="13">⌂</Button>
                </StackPanel>

                <!-- No object hint -->
                <TextBlock x:Name="EmptyHint" Text="Нажмите «Примитив» чтобы добавить объект в сцену"
                           Foreground="#333" FontSize="14" TextAlignment="Center"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Splitter right -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#1A1A1A" Cursor="SizeWE"/>

            <!-- ====== RIGHT PANEL: Properties + Material ====== -->
            <Border Grid.Column="4" Background="#252525" BorderBrush="#111" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- === OBJECT PROPERTIES === -->
                        <Border Style="{StaticResource SectionHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="СВОЙСТВА" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="10,8">
                            <!-- Name -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Имя" Style="{StaticResource PropLabel}"/>
                                <TextBox Grid.Column="1" x:Name="ObjNameBox" Style="{StaticResource PropField}"
                                         TextChanged="ObjName_TextChanged" ToolTip="Имя объекта"/>
                            </Grid>

                            <Separator Background="#1A1A1A" Margin="0,4,0,8"/>

                            <!-- Position -->
                            <TextBlock Text="ПОЗИЦИЯ" Foreground="#555" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X" Foreground="#E07070" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Y" Foreground="#70C070" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Z" Foreground="#7090E0" FontSize="9" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="PosXBox" Style="{StaticResource XyzField}" Margin="0,0,2,0" IsReadOnly="True" Text="0.00"/>
                                <TextBox Grid.Column="1" x:Name="PosYBox" Style="{StaticResource XyzField}" Margin="2,0,2,0" IsReadOnly="True" Text="0.00"/>
                                <TextBox Grid.Column="2" x:Name="PosZBox" Style="{StaticResource XyzField}" Margin="2,0,0,0" IsReadOnly="True" Text="0.00"/>
                            </Grid>

                            <!-- Rotation -->
                            <TextBlock Text="ВРАЩЕНИЕ" Foreground="#555" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X°" Foreground="#E07070" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Y°" Foreground="#70C070" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Z°" Foreground="#7090E0" FontSize="9" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="RotXBox" Style="{StaticResource XyzField}" Margin="0,0,2,0" IsReadOnly="True" Text="0°"/>
                                <TextBox Grid.Column="1" x:Name="RotYBox" Style="{StaticResource XyzField}" Margin="2,0,2,0" IsReadOnly="True" Text="0°"/>
                                <TextBox Grid.Column="2" x:Name="RotZBox" Style="{StaticResource XyzField}" Margin="2,0,0,0" IsReadOnly="True" Text="0°"/>
                            </Grid>

                            <!-- Scale -->
                            <TextBlock Text="МАСШТАБ" Foreground="#555" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X" Foreground="#E07070" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Y" Foreground="#70C070" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Z" Foreground="#7090E0" FontSize="9" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ScaleXBox" Style="{StaticResource XyzField}" Margin="0,0,2,0" IsReadOnly="True" Text="1.00"/>
                                <TextBox Grid.Column="1" x:Name="ScaleYBox" Style="{StaticResource XyzField}" Margin="2,0,2,0" IsReadOnly="True" Text="1.00"/>
                                <TextBox Grid.Column="2" x:Name="ScaleZBox" Style="{StaticResource XyzField}" Margin="2,0,0,0" IsReadOnly="True" Text="1.00"/>
                            </Grid>
                        </StackPanel>

                        <!-- === MATERIAL === -->
                        <Border Style="{StaticResource SectionHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#A78BFA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="МАТЕРИАЛ" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="10,8" x:Name="MaterialPanel">

                            <!-- Diffuse color -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Цвет" Style="{StaticResource PropLabel}"/>
                                <Border Grid.Column="1" x:Name="ColorSwatch" Background="#3B82F6"
                                        CornerRadius="4" Height="22" Cursor="Hand"
                                        MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Выбрать цвет"/>
                                <TextBlock Grid.Column="2" x:Name="ColorHexLabel" Text="#3B82F6"
                                           Foreground="#888" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Opacity -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Прозрачн." Style="{StaticResource PropLabel}"/>
                                <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="1"
                                        ValueChanged="MatSlider_Changed" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="OpacityLabel" Text="1.0" FontSize="10"
                                           Foreground="#888" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <!-- Texture -->
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Текстура" Style="{StaticResource PropLabel}"/>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarBtn}"
                                        Click="PickTexture_Click" FontSize="10"
                                        ToolTip="Выбрать файл изображения">
                                    <TextBlock Text="Выбрать файл..." FontSize="10"/>
                                </Button>
                            </Grid>
                            <!-- Texture path display -->
                            <Border Background="#1A1A1A" CornerRadius="3" Padding="5,4" Margin="0,0,0,4">
                                <TextBlock x:Name="TexturePathLabel" Text="Текстура не выбрана"
                                           Foreground="#555" FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Border>
                            <!-- Clear texture -->
                            <Button Style="{StaticResource ToolbarBtn}" Margin="0,0,0,4"
                                    Click="ClearTexture_Click" FontSize="10">
                                <TextBlock Text="✕ Убрать текстуру" FontSize="10"/>
                            </Button>

                            <!-- Apply button -->
                            <Button Style="{StaticResource ToolbarBtnAccent}" Margin="0,6,0,0"
                                    Click="ApplyMaterial_Click" HorizontalAlignment="Stretch">
                                <TextBlock Text="Применить материал" FontSize="11"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="3" Background="#1A1A1A" BorderBrush="#111" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Готово" Foreground="#666" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="StatusObjects" Text="Объектов: 0"
                           Foreground="#555" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="2" x:Name="StatusSelected" Text="Ничего не выбрано"
                           Foreground="#555" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Net 8 · WPF · HelixToolkit 2.27"
                           Foreground="#333" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
