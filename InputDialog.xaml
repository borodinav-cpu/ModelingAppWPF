<Window x:Class="ModelingAppWPF.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод угла поворота" 
        Height="150" Width="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B2B2B">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Введите угол поворота (градусы):" 
                   Foreground="White" 
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" 
                 x:Name="AngleTextBox" 
                 Background="#3C3F41" 
                 Foreground="White" 
                 BorderBrush="#555555"
                 Padding="5"
                 FontSize="14"/>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,0">

            <Button Content="OK" 
                    Click="Ok_Click" 
                    Padding="15,5" 
                    Margin="0,0,5,0"
                    Background="#3B82F6" 
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="Отмена" 
                    Click="Cancel_Click" 
                    Padding="15,5"
                    Background="#555555" 
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>